		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Global test script",
					"pm.test('Response format is correct', () => {",
					"    if (pm.response.code === 200) {",
					"        const response = pm.response.json();",
					"        pm.expect(response).to.have.property('success');",
