		{
			"name": "Public Profile Access",
			"item": [
				{
					"name": "Get Minimal Profile by Username",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Minimal profile retrieved successfully', () => {",
									"    pm.expect(pm.response.code).to.equal(200);",
									"    const response = pm.response.json();",
									"    pm.expect(response.success).to.be.true;",
									"});",
									"",
									"pm.test('Only minimal data exposed', () => {",
									"    const response = pm.response.json();",
									"    const profile = response.data;",
									"    ",
									"    // 포함되어야 할 정보",
									"    pm.expect(profile).to.have.property('username');",
									"    pm.expect(profile).to.have.property('display_name');",
									"    pm.expect(profile).to.have.property('manner_temperature');",
									"    pm.expect(profile).to.have.property('trust_level');",
									"    pm.expect(profile).to.have.property('total_activities');",
									"    pm.expect(profile).to.have.property('completion_rate');",
									"    ",
									"    // 포함되지 않아야 할 민감한 정보",
									"    pm.expect(profile).to.not.have.property('email');",
									"    pm.expect(profile).to.not.have.property('no_show_count');",
									"    pm.expect(profile).to.not.have.property('total_ratings');",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/users/testuser/minimal",
							"host": ["{{base_url}}"],
							"path": ["users", "testuser", "minimal"]
						}
					}
				}
			]
		},
