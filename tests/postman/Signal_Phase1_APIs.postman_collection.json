{
	"info": {
		"name": "Signal Phase 1 - Minimal Profile APIs",
		"description": "Phase 1 최소주의 프로필 시스템 API 테스트 컬렉션",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"version": "1.0.0"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{auth_token}}",
				"type": "string"
			}
		]
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8080/api/v1",
			"type": "string"
		},
		{
			"key": "auth_token",
			"value": "",
			"type": "string"
		},
		{
			"key": "test_user_id",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Authentication",
			"item": [
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    pm.collectionVariables.set('auth_token', response.data.token);",
									"    pm.test('Login successful', () => {",
									"        pm.expect(response.success).to.be.true;",
									"        pm.expect(response.data.token).to.be.a('string');",
									"    });",
									"} else {",
									"    pm.test('Login failed', () => {",
									"        pm.expect.fail('Login request failed');",
									"    });",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"test@example.com\",\n    \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/login",
							"host": ["{{base_url}}"],
							"path": ["auth", "login"]
						}
					}
				}
			]
		},
		{
			"name": "Profile Management",
			"item": [
				{
					"name": "Get My Profile",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Profile retrieved successfully', () => {",
									"    pm.expect(pm.response.code).to.equal(200);",
									"    const response = pm.response.json();",
									"    pm.expect(response.success).to.be.true;",
									"    pm.expect(response.data).to.have.property('manner_temperature');",
									"    pm.expect(response.data).to.have.property('trust_level');",
									"    pm.expect(response.data).to.have.property('completion_rate');",
									"});",
									"",
									"pm.test('Manner temperature is valid', () => {",
									"    const response = pm.response.json();",
									"    const temp = response.data.manner_temperature;",
									"    pm.expect(temp).to.be.at.least(20.0);",
									"    pm.expect(temp).to.be.at.most(50.0);",
									"});",
									"",
									"pm.test('Sensitive data not exposed', () => {",
									"    const response = pm.response.json();",
									"    pm.expect(response.data).to.not.have.property('password');",
									"    pm.expect(response.data).to.not.have.property('email');",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/users/profile",
							"host": ["{{base_url}}"],
							"path": ["users", "profile"]
						}
					}
				},
				{
					"name": "Quick Setup Profile",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Quick setup successful', () => {",
									"    pm.expect(pm.response.code).to.equal(200);",
									"    const response = pm.response.json();",
									"    pm.expect(response.success).to.be.true;",
									"    pm.expect(response.data.setup_completed).to.be.true;",
									"});",
									"",
									"pm.test('Profile data updated correctly', () => {",
									"    const response = pm.response.json();",
									"    pm.expect(response.data.display_name).to.equal('빠른설정테스트');",
									"    pm.expect(response.data.avatar).to.equal('😊');",
									"    pm.expect(response.data.one_line).to.equal('Signal 테스트 중입니다');",
									"    pm.expect(response.data.manner_temperature).to.equal(36.5);",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"display_name\": \"빠른설정테스트\",\n    \"avatar\": \"😊\",\n    \"one_line\": \"Signal 테스트 중입니다\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/users/quick-setup",
							"host": ["{{base_url}}"],
							"path": ["users", "quick-setup"]
						}
					}
				},
				{
					"name": "Update Profile",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Profile updated successfully', () => {",
									"    pm.expect(pm.response.code).to.equal(200);",
									"    const response = pm.response.json();",
									"    pm.expect(response.success).to.be.true;",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"display_name\": \"업데이트된닉네임\",\n    \"avatar\": \"🎾\",\n    \"one_line\": \"테니스를 좋아하는 사람\",\n    \"notifications_enabled\": true\n}"
						},
						"url": {
							"raw": "{{base_url}}/users/profile",
							"host": ["{{base_url}}"],
							"path": ["users", "profile"]
						}
					}
				}
			]
		},
		{
			"name": "Manner Temperature System",
			"item": [
				{
					"name": "Update Manner Temperature - Signal Created",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
