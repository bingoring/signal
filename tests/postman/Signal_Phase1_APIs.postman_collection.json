				{
					"name": "Get Trust Stats",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Trust stats retrieved successfully', () => {",
									"    pm.expect(pm.response.code).to.equal(200);",
									"    const response = pm.response.json();",
									"    pm.expect(response.success).to.be.true;",
									"});",
									"",
									"pm.test('Trust stats contain all required fields', () => {",
									"    const response = pm.response.json();",
									"    const stats = response.data;",
									"    pm.expect(stats).to.have.property('manner_temperature');",
									"    pm.expect(stats).to.have.property('trust_level');",
									"    pm.expect(stats).to.have.property('completion_rate');",
									"    pm.expect(stats).to.have.property('signal_count');",
									"    pm.expect(stats).to.have.property('join_count');",
									"    pm.expect(stats).to.have.property('total_activities');",
									"    pm.expect(stats).to.have.property('no_show_count');",
									"    pm.expect(stats).to.have.property('is_recently_active');",
									"});"
								]
							}
						}
					],
