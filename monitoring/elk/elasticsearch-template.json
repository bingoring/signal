{
  "index_patterns": ["signal-logs-*"],
  "template": {
    "settings": {
      "number_of_shards": 2,
      "number_of_replicas": 1,
      "index.refresh_interval": "30s",
      "index.codec": "best_compression",
      "index.mapping.total_fields.limit": 2000,
      "index.max_result_window": 100000,
      "analysis": {
        "analyzer": {
          "signal_analyzer": {
            "type": "custom",
            "tokenizer": "standard",
            "filter": ["lowercase", "stop", "signal_synonyms"]
          }
        },
        "filter": {
          "signal_synonyms": {
            "type": "synonym",
            "synonyms": [
              "error,err,failure",
              "warning,warn,alert",
              "info,information",
              "debug,trace"
            ]
          }
        }
      }
    },
    "mappings": {
      "properties": {
        "@timestamp": {
          "type": "date",
          "format": "strict_date_optional_time||epoch_millis"
        },
        "timestamp": {
          "type": "date",
          "format": "strict_date_optional_time||epoch_millis"
        },
        "processed_at": {
          "type": "date",
          "format": "strict_date_optional_time||epoch_millis"
        },
        "service": {
          "type": "keyword",
          "fields": {
            "text": {
              "type": "text",
              "analyzer": "signal_analyzer"
            }
          }
        },
        "environment": {
          "type": "keyword"
        },
        "log_level": {
          "type": "keyword",
          "fields": {
            "text": {
              "type": "text",
              "analyzer": "signal_analyzer"
            }
          }
        },
        "message": {
          "type": "text",
          "analyzer": "signal_analyzer",
          "fields": {
            "keyword": {
              "type": "keyword",
              "ignore_above": 1024
            }
          }
        },
        "log_message": {
          "type": "text",
          "analyzer": "signal_analyzer"
        },
        "request_id": {
          "type": "keyword"
        },
        "user_id": {
          "type": "keyword"
        },
        "signal_id": {
          "type": "keyword"
        },
        "chat_room_id": {
          "type": "keyword"
        },
        "session_id": {
          "type": "keyword"
        },
        "client_ip": {
          "type": "ip"
        },
        "user_agent": {
          "type": "text",
          "fields": {
            "keyword": {
              "type": "keyword",
              "ignore_above": 512
            }
          }
        },
        "response_time": {
          "type": "integer"
        },
        "response_size": {
          "type": "integer"
        },
        "status_code": {
          "type": "integer"
        },
        "method": {
          "type": "keyword"
        },
        "endpoint": {
          "type": "keyword",
          "fields": {
            "text": {
              "type": "text",
              "analyzer": "signal_analyzer"
            }
          }
        },
        "query_duration": {
          "type": "float"
        },
        "sql_query": {
          "type": "text",
          "analyzer": "standard",
          "fields": {
            "keyword": {
              "type": "keyword",
              "ignore_above": 1024
            }
          }
        },
        "ws_action": {
          "type": "keyword"
        },
        "room_id": {
          "type": "keyword"
        },
        "ws_details": {
          "type": "text",
          "analyzer": "signal_analyzer"
        },
        "error": {
          "properties": {
            "type": {
              "type": "keyword"
            },
            "message": {
              "type": "text",
              "analyzer": "signal_analyzer"
            },
            "stack_trace": {
              "type": "text",
              "index": false
            },
            "code": {
              "type": "keyword"
            }
          }
        },
        "geoip": {
          "properties": {
            "location": {
              "type": "geo_point"
            },
            "country_name": {
              "type": "keyword"
            },
            "country_code": {
              "type": "keyword"
            },
            "city_name": {
              "type": "keyword"
            },
            "region_name": {
              "type": "keyword"
            },
            "timezone": {
              "type": "keyword"
            }
          }
        },
        "ua": {
          "properties": {
            "device": {
              "type": "keyword"
            },
            "name": {
              "type": "keyword"
            },
            "os": {
              "type": "keyword"
            },
            "os_name": {
              "type": "keyword"
            },
            "version": {
              "type": "keyword"
            }
          }
        },
        "tags": {
          "type": "keyword"
        },
        "fields": {
          "type": "object",
          "dynamic": true
        },
        "kubernetes": {
          "properties": {
            "pod": {
              "properties": {
                "name": {
                  "type": "keyword"
                },
                "uid": {
                  "type": "keyword"
                }
              }
            },
            "namespace": {
              "type": "keyword"
            },
            "node": {
              "properties": {
                "name": {
                  "type": "keyword"
                }
              }
            },
            "labels": {
              "type": "object",
              "dynamic": true
            }
          }
        },
        "container": {
          "properties": {
            "id": {
              "type": "keyword"
            },
            "name": {
              "type": "keyword"
            },
            "image": {
              "properties": {
                "name": {
                  "type": "keyword"
                }
              }
            }
          }
        },
        "host": {
          "properties": {
            "name": {
              "type": "keyword"
            },
            "hostname": {
              "type": "keyword"
            },
            "ip": {
              "type": "ip"
            },
            "mac": {
              "type": "keyword"
            },
            "os": {
              "properties": {
                "name": {
                  "type": "keyword"
                },
                "family": {
                  "type": "keyword"
                },
                "version": {
                  "type": "keyword"
                }
              }
            }
          }
        }
      }
    }
  },
  "version": 1,
  "_meta": {
    "description": "Template for Signal application logs",
    "created_by": "Signal Engineering Team",
    "created_date": "2024-01-01"
  }
}